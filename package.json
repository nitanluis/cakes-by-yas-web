{
  "name": "cakes-by-yas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:design": "node scripts/check-design-sync.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check": "npm run check:tokens && npm run check:design && npm run check:colors && npm run check:content && npm run check:motion && npm run check:docs && node scripts/astro.mjs check",
    "check:motion": "node scripts/check-motion-time.mjs",
    "build": "npm run check && node scripts/astro.mjs build && node scripts/check-built.mjs",
    "flujos": "node scripts/flujos.mjs",
    "check:docs": "node scripts/check-docs.mjs docs/claims.yml --shell powershell.exe",
    "check:colors": "node scripts/check-colors.mjs"
  },
  "dependencies": {
    "astro": "7.4.4",
    "gsap": "3.15.0",
    "lenis": "1.3.27"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "axe-core": "4.14.0",
    "typescript": "6.0.3"
  }
}
