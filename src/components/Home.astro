---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { heroImage, heroAlt } from '../data/hero';
import Layout from '../layouts/Layout.astro';
import ScrollSignature from './icons/ScrollSignature.astro';
import Button from './Button.astro';
import CakeCard from './CakeCard.astro';
import Catalog from './Catalog.astro';
import Decor from './icons/Decor.astro';
import { copy } from '../data/copy';
import { brand } from '../data/brand';
import { sitePath } from '../shared/site-path';
import { creations, business, whatsapp, type Locale, type Localized } from '../data/catalog';
interface Props { locale: Locale; entry?: boolean; review?: boolean; heroPreview?: { image: ImageMetadata; alt: Localized }; }
const { locale, entry = false, review = false, heroPreview } = Astro.props;
const t = copy[locale];
const breakLines = (text: string) => text.split('\n');
const title = locale === 'es' ? 'Cakes by Yas — Pasteles de cumpleaños por encargo' : 'Cakes by Yas — Custom birthday cakes & sweet celebrations';
const description = locale === 'es' ? 'Pasteles personalizados, tres leches, flanes y mini postres para celebrar. Consulta con Yas por WhatsApp. Solo recogida en Texas.' : 'Custom birthday cakes, tres leches, flan and mini desserts for your celebration. Plan your order with Yas on WhatsApp. Pickup only in Texas.';
---
<Layout locale={locale} title={title} description={description} entry={entry} intro={!review} gallery={review}>
  <slot name="review" />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__media" data-hero-media><Image src={heroPreview?.image || heroImage} alt={(heroPreview?.alt || heroAlt)[locale]} widths={[800, 1200, 1672]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" /></div>
      <div class="hero__content"><p class="eyebrow">{t.eyebrow}</p><h1 id="hero-title" aria-label={t.hero.join(" ")} data-word-reveal>{t.hero.map(line => <span class="hero__line">{line}{" "}</span>)}</h1><p class="hero__location">{t.pickup}<br />Spring · The Woodlands · Houston</p></div>
      <div class="hero__front" data-hero-front><Button href="#cakes" variant="circle" class="hero__cta">{t.explore}</Button></div>
      <ScrollSignature label={locale === 'es' ? 'Sigue explorando' : 'Keep exploring'} />
    </section>
    <section class="section intro" aria-labelledby="intro-title"><h2 id="intro-title" aria-label={t.intro.replaceAll("\n"," ")} class="display-title" data-reveal>{breakLines(t.intro).map(line => <span>{line}</span>)}</h2><div data-reveal><p class="large-copy">{t.introCopy}</p><a class="text-link" href="#menu">{t.nav[1]} </a></div></section>
    <section class="featured-section" id="cakes" aria-labelledby="featured-title">
      <div class="section-heading"><p class="eyebrow" id="featured-title">{t.featured}</p></div>
      <div class="featured-bands" aria-hidden="true">{Array.from({length:4}, (_,i) => <div class:list={['marquee', {'marquee--outline':i%2===0,'marquee--reverse':i%2===0}]}><div>{Array.from({length:8},()=><span>{t.marquee}</span>)}</div></div>)}</div>
      <div class="featured-grid section">{creations.slice(0, 3).map(cake => <CakeCard cake={cake} locale={locale} arch />)}</div>
    </section>
    <section class="custom-intro section"><h2 class="display-title" data-reveal>{t.custom}</h2></section>
    <div class="arches" aria-hidden="true"><div class="arches__track">{[0,1].map(()=><div class="arches__sequence">{creations.map((cake,i)=><><div class:list={['arches__image',{'arches__image--tall':i%2===0}]} data-arch-window><div class="arches__mask"><div class="arches__frame"><Image src={cake.image} alt="" widths={[400,640]} sizes="(max-width:768px) 60vw,20vw" format="webp" loading="lazy" /></div></div></div>{i%3===1&&<span class="arches__separator"><Decor variant="separator" /></span>}</>)}</div>)}</div></div>
    <section class="section menu-section" id="menu" aria-labelledby="menu-title"><div class="section-intro"><h2 id="menu-title" aria-label={t.menu.replaceAll("\n"," ")} class="display-title" data-reveal>{breakLines(t.menu).map(line => <span>{line}</span>)}</h2><p class="large-copy" data-reveal>{t.menuCopy}</p></div><Catalog locale={locale} /></section>
    <section class="section services" id="celebrations" aria-labelledby="services-title"><div class="section-intro"><div><p class="eyebrow">{t.serviceLabel}</p><h2 id="services-title" aria-label={t.services.replaceAll("\n"," ")} class="display-title" data-reveal>{breakLines(t.services).map(line => <span>{line}</span>)}</h2></div><p class="large-copy">{t.location}</p></div><div class="service-grid"><article class="service-block" data-reveal><span class="service-number" aria-hidden="true">01</span><h3>{t.large}</h3><p>{t.largeCopy}</p><a class="text-link" href={whatsapp(locale, t.large)}>{t.quote}</a></article><article class="service-block" data-reveal><span class="service-number" aria-hidden="true">02</span><h3>{t.tables}</h3><p>{t.tablesCopy}</p><a class="text-link" href={whatsapp(locale, t.tables)}>{t.quote}</a></article></div></section>
    <section class="section order-feature" id="order" aria-labelledby="order-title"><h2 class="sr-only" id="order-title" aria-label={t.process.replaceAll("\n"," ")}>{breakLines(t.process).map(line=><span>{line}</span>)}</h2><div class="order-feature__art"><div class="order-feature__window"><Image src={creations[1].image} alt={creations[1].alt[locale]} widths={[600,900]} sizes="(max-width:768px) 65vw,30vw" format="webp" loading="lazy" /></div><Decor variant="arch-title" id="celebrate-arch" text={t.orderRing}/><div class="order-feature__cta" data-grow><Button variant="order" href={whatsapp(locale)} label={t.order}>{locale === "es" ? "Pedir" : "Order"}</Button></div></div><p class="large-copy" data-reveal>{t.processCopy}</p><a class="text-link" href={business.instagram}>{t.instagram} ↗</a></section>
    <section class="section process" aria-label={locale === 'es' ? 'Proceso de pedido' : 'Ordering process'}><p class="eyebrow process__label">{t.processLabel}</p><ol>{t.steps.map((step,i)=><li data-step><span class="step-number" aria-hidden="true">0{i+1}</span><span class="step-node" aria-hidden="true"></span><h3>{step}</h3><p>{t.stepCopy[i]}</p></li>)}</ol><div class="order-notes"><p>{t.notice}</p><p>{t.payment}</p></div></section>
  </main>
  <footer class="site-footer"><Decor variant="wave" /><div class="footer-cta"><h2 class="display-title" data-reveal>{breakLines(t.footer).map(line => <span>{line}</span>)}</h2><div><p class="large-copy">{t.footerCopy}</p><Button href={whatsapp(locale)}>{t.order}</Button></div></div><div class="footer-links"><p>{t.pickup}<br />{t.location}</p><nav aria-label={locale === 'es' ? 'Contacto y navegación inferior' : 'Contact and footer navigation'}><a href={business.instagram}>Instagram ↗</a><a href={whatsapp(locale)}>WhatsApp</a><a href="#menu">{t.nav[1]} ↑</a></nav><p>{t.payment}<br />+1 862-668-0038</p></div><img class="footer-wordmark" src={brand.inverseLogo} width={brand.width} height={brand.height} alt="Cakes by Yas" loading="lazy" /><div class="footer-bottom"><small>© {new Date().getFullYear()} Cakes by Yas</small><a href={sitePath(`${locale === 'en' ? 'es' : 'en'}/`)} data-language lang={locale === 'en' ? 'es' : 'en'}>{locale === 'en' ? 'Español' : 'English'}</a><small>Apfel Grotezk · Luigi Gorlero & Collletttivo</small></div></footer>
  <dialog class="photo-dialog" data-photo-dialog aria-labelledby="photo-title"><div class="photo-dialog__top"><h2 id="photo-title">{t.photoTitle}</h2><button class="icon-button" data-dialog-close aria-label={t.close}>×</button></div>{creations.map(cake => <figure data-photo-panel={cake.id} hidden><Image src={cake.image} alt={cake.alt[locale]} widths={[600, 1122]} sizes="(max-width:768px) 90vw, 550px" format="webp" loading="lazy" /><figcaption><h3>{cake.title[locale]}</h3><p>{cake.kind[locale]}</p><Button href={whatsapp(locale, cake.title[locale])} product={`creation-${cake.id}`}>{t.quote}</Button></figcaption></figure>)}</dialog>
</Layout>
